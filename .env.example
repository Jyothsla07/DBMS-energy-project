# Copy this file to .env and fill in your values. .env is excluded from git.

# MySQL connection used by python/nl2sql.py and python/ask_web.py
# Tip: use the read-only user from sql/04_readonly_user.sql instead of root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PWD=
MYSQL_DB=energydb

# Open-source model from Hugging Face that turns questions into SQL (runs locally)
NL2SQL_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
